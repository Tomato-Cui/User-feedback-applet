
.container {
	padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}
.banner {
	position: relative;
	width: 100%;
	height: 400rpx;
}
.banner image {
	width: 100%;
	height: 100%;
}
.banner-text {
	position: absolute;
	left: 40rpx;
	bottom: 40rpx;
	color: #fff;
}
.company-name {
	font-size: 48rpx;
	font-weight: bold;
	display: block;
	margin-bottom: 10rpx;
	text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}
.slogan {
	font-size: 28rpx;
	opacity: 0.9;
	text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}
.grid-container {
	padding: 30rpx;
	background-color: #fff;
}
.grid-title, .section-title {
	font-size: 36rpx;
	font-weight: bold;
	margin-bottom: 30rpx;
	color: #333;
}
.grid-list {
	display: flex;
	flex-wrap: wrap;
	margin: 0 -10rpx;
}
.grid-item {
	width: calc(50% - 20rpx);
	margin: 10rpx;
	background-color: #fff;
	border-radius: 12rpx;
	box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
	overflow: hidden;
	transition: all 0.3s;
}
.grid-item:active {
	-webkit-transform: scale(0.98);
	        transform: scale(0.98);
}
.item-icon {
	height: 160rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #f8f8f8;
}
.item-icon image {
	width: 80rpx;
	height: 80rpx;
}
.item-content {
	padding: 20rpx;
}
.item-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 10rpx;
	display: block;
}
.item-desc {
	font-size: 24rpx;
	color: #666;
	line-height: 1.4;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.about-section {
	margin-top: 30rpx;
	padding: 30rpx;
	background-color: #fff;
}
.about-content {
	background-color: #f8f8f8;
	padding: 30rpx;
	border-radius: 12rpx;
}
.about-text {
	font-size: 28rpx;
	color: #666;
	line-height: 1.6;
}

/* 底部导航栏样式 */
.tab-bar {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	height: 100rpx;
	background-color: #ffffff;
	display: flex;
	justify-content: space-around;
	align-items: center;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	padding-bottom: env(safe-area-inset-bottom); /* 适配iPhone全面屏 */
}
.tab-item {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 10rpx 0;
}
.tab-item image {
	width: 44rpx;
	height: 44rpx;
	margin-bottom: 4rpx;
}
.tab-item text {
	font-size: 24rpx;
	color: #333;
}

