<view class="container"><view class="banner"><image src="/static/banner.jpg" mode="aspectFill"></image><view class="banner-text"><text class="company-name">科技创新服务</text><text class="slogan">智能物联 · 技术引领 · 创新服务</text></view></view><view class="grid-container"><view class="grid-title">我们的服务</view><view class="grid-list"><block wx:for="{{serviceList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['navigateToDetail',['$0'],[[['serviceList','',index]]]]]]]}}" class="grid-item" bindtap="__e"><view class="item-icon"><image src="{{item.icon}}" mode="aspectFit"></image></view><view class="item-content"><text class="item-title">{{item.title}}</text><text class="item-desc">{{item.description}}</text></view></view></block></view></view><view class="about-section"><view class="section-title">关于我们</view><view class="about-content"><text class="about-text">我们是一家专注于物联网技术研发和信息系统集成服务的高新技术企业，致力于为客户提供全方位的技术解决方案。</text></view></view><view class="tab-bar"><block wx:for="{{tabList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['switchTab',['$0'],[[['tabList','',index]]]]]]]}}" class="tab-item" bindtap="__e"><image src="{{item.icon}}" mode="aspectFit"></image><text>{{item.name}}</text></view></block></view></view>